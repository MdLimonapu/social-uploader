# Copy to .env and fill in. Leave blank for platforms you don't use.
HOST=127.0.0.1
PORT=8000
# Set a password to protect every page (strongly recommended when using a public tunnel / VM)
APP_PASSWORD=
# Delete the uploaded copy in uploads/ after a job finishes
DELETE_AFTER_POST=true
BASE_URL=http://localhost:8000

# YouTube: put client_secret.json (OAuth "Web application") in project folder
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
# ...or just fill these two (Settings page writes client_secret.json for you)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_PRIVACY=public   # public | unlisted | private

# TikTok (developers.tiktok.com) - Login Kit + Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE  # used if your account allows it; unaudited apps fall back to SELF_ONLY

# Facebook / Instagram (developers.facebook.com)
FB_APP_ID=
FB_APP_SECRET=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=     # long-lived Page token (or use Connect button)
IG_USER_ID=               # Instagram Business/Creator account id (auto-filled by Connect)
GRAPH_VERSION=v21.0

# Instagram needs a PUBLIC https URL that points at this app (e.g. cloudflared tunnel)
# Example: PUBLIC_BASE_URL=https://abc-def.trycloudflare.com
PUBLIC_BASE_URL=

# Instagram API with Instagram Login (no Facebook Page needed) – Meta app → Instagram → API setup with Instagram login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# ...or paste an existing long-lived token (e.g. from n8n) – no app ID/secret needed
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Watch folder
WATCH_ENABLED=true
WATCH_PLATFORMS=youtube,tiktok,instagram,facebook
WATCH_INTERVAL_SECONDS=15
