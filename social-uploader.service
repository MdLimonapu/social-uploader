# Copy to /etc/systemd/system/social-uploader.service, edit User and WorkingDirectory, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now social-uploader
#   journalctl -u social-uploader -f      # logs (public URL is printed at start)
[Unit]
Description=Social Uploader (FastAPI + cloudflared quick tunnel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_LINUX_USER
WorkingDirectory=/home/YOUR_LINUX_USER/social-uploader
ExecStart=/home/YOUR_LINUX_USER/social-uploader/start-always.sh
Restart=always
RestartSec=5
KillMode=control-group
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
